{
    "name": "dpezer/silverstripe-remote-assets",
    "description": "Serve missing asset files from a remote Silverstripe site on the frontend, without storing them locally.",
    "type": "silverstripe-vendormodule",
    "homepage": "https://github.com/dpezer/silverstripe-remote-assets",
    "keywords": [
        "silverstripe",
        "assets",
        "remote",
        "development"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Darjan Pezer"
        }
    ],
    "support": {
        "issues": "https://github.com/dpezer/silverstripe-remote-assets/issues"
    },
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/assets": "^3",
        "guzzlehttp/guzzle": "^7",
        "league/mime-type-detection": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/standards": "^1"
    },
    "suggest": {
        "silverstripe/admin": "Remote URLs are disabled inside the CMS (LeftAndMain) automatically"
    },
    "autoload": {
        "psr-4": {
            "Dpws\\RemoteAssets\\": "src/",
            "Dpws\\RemoteAssets\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "installer-name": "remote-assets"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
